# Nome exibido no menu de boas-vindas
BOT_NOME=Assistente Virtual
BOT_EMPRESA=Minha Empresa LTDA

# Conhecimento da empresa para a IA (use \n para quebras de linha)
# Veja docs/contexto/empresa.exemplo.txt como referência
BOT_CONTEXTO=Descreva aqui produtos, preços, horários e políticas reais da sua empresa.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=400
GROQ_HISTORICO_MAX=12

# Pasta onde a sessão WhatsApp (Baileys) é salva
AUTH_DIR=.auth

# true = responde na conversa "Mensagens para você" (teste no mesmo WhatsApp Web)
# false = só responde mensagens de OUTROS números (recomendado em produção)
BOT_MODO_TESTE=false

# Nível de log: trace | debug | info | warn | error
LOG_LEVEL=info
